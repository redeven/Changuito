{
  "manifest_version": 3,
  "name": "Changuito para Steam",
  "version": "1.1.1",
  "description": "Precios de Steam en pesos argentinos con impuestos incluidos y análisis de precio regional.",
  "icons": {
    "128": "icons/icon-128.png"
  },
  "browser_specific_settings": {
    "gecko": {
      "id": "changuito@redeven",
      "strict_min_version": "128.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "action": {
    "default_title": "Configuración de Changuito",
    "default_icon": {
      "128": "icons/icon-128.png"
    },
    "default_popup": "popup.html"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://mercados.ambito.com/*",
    "https://store.steampowered.com/*",
    "https://steamcommunity.com/*"
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "icons/links/*"
      ],
      "matches": [
        "https://store.steampowered.com/*",
        "https://steamcommunity.com/*"
      ]
    }
  ],
  "content_scripts": [
    {
      "matches": [
        "https://store.steampowered.com/*",
        "https://steamcommunity.com/app/*"
      ],
      "run_at": "document_idle",
      "js": [
        "content.js"
      ],
      "css": [
        "price-overlay.css"
      ]
    }
  ]
}
